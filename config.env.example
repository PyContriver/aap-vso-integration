# =============================================================================
# aap-vso-integration/config.env
# Copy to config.env and fill in your values.
# All VSO VaultStaticSecrets use CLUSTER_NAME to build Vault paths.
# =============================================================================

# Cluster identifier — used as Vault path segment: aap/<CLUSTER_NAME>/...
CLUSTER_NAME=rosa-cnet-01

# HCP Vault or self-managed Vault endpoint (reachable from inside OCP)
VAULT_ADDR=https://your-vault.example.com:8200

# Vault KV v2 mount name
VAULT_MOUNT=secret

# Vault Kubernetes auth mount path
VAULT_K8S_AUTH_MOUNT=kubernetes

# Vault role bound to VSO ServiceAccount
VAULT_K8S_ROLE=aap-role
